{
    "name": "State timeline",
    "description": "Shows each series' status over time as coloured runs: one row per series, one segment per run of the same state, with Grafana value mappings for each state's text and colour.",
    "version": "1.0.0",
    "publishedAt": "2026-11-08T00:00:00.000Z",
    "changelog": "Initial HouseRx release.",
    "tags": ["houserx", "status", "timeline"],
    "icon": "timeline",
    "vizSchema": {
        "fields": [
            {
                "name": "time",
                "label": "Time",
                "type": "dimension",
                "required": true,
                "description": "When each state was sampled. A state lasts until the series' next sample; the last one lasts one sample interval."
            },
            {
                "name": "series",
                "label": "Series",
                "type": "dimension",
                "required": true,
                "description": "What the state belongs to, such as a service or host. One row per series, in the order they first appear."
            },
            {
                "name": "state",
                "label": "State",
                "type": "dimension",
                "required": true,
                "description": "The state at that time, such as up or down. Consecutive samples with the same state merge into one segment; an empty state leaves a gap."
            }
        ],
        "configOptions": [
            {
                "name": "valueMappings",
                "label": "Value mappings",
                "type": "text",
                "default": ""
            }
        ],
        "colorPalette": {}
    },
