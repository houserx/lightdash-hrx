{
    "name": "Stat",
    "description": "Shows one big value reduced from the rows (last not-null by default, or min, max, mean, total and more), formatted with a Grafana unit and decimals, or No data when there is nothing to show, over a sparkline of the series in time order.",
    "version": "1.3.0",
    "publishedAt": "2026-11-08T00:00:00.000Z",
    "changelog": "Grafana value mappings (value, range, regex and the null and NaN specials) replace the value's text and unit, and their colour replaces the threshold colour.",
    "tags": ["houserx", "stat", "single-value"],
    "icon": "number",
    "vizSchema": {
        "fields": [
            {
                "name": "value",
                "label": "Value",
                "type": "metric",
                "required": true,
                "description": "The numbers to reduce to one value. Empty cells are skipped by the not-null reducers."
            },
            {
                "name": "time",
                "label": "Time",
                "type": "dimension",
                "required": false,
                "description": "When each value was sampled. Rows are read in time order, so Last is the latest value; without it, row order is used."
            }
        ],
        "configOptions": [
            {
                "name": "reducer",
                "label": "Calculation",
                "type": "select",
                "choices": [
                    {
                        "value": "lastNotNull",
                        "label": "Last *"
                    },
                    {
                        "value": "last",
                        "label": "Last"
                    },
                    {
                        "value": "firstNotNull",
                        "label": "First *"
                    },
                    {
                        "value": "first",
                        "label": "First"
                    },
                    {
                        "value": "min",
                        "label": "Min"
                    },
                    {
                        "value": "max",
                        "label": "Max"
                    },
                    {
                        "value": "mean",
                        "label": "Mean"
                    },
                    {
                        "value": "sum",
                        "label": "Total"
                    },
                    {
                        "value": "count",
                        "label": "Count"
                    },
                    {
                        "value": "range",
                        "label": "Range"
                    }
                ],
                "default": "lastNotNull"
            },
            {
                "name": "unit",
                "label": "Unit",
                "type": "text",
                "default": ""
            },
            {
                "name": "decimals",
                "label": "Decimals (-1 for auto)",
                "type": "number",
                "default": -1,
                "min": -1,
                "max": 20
            },
            {
                "name": "thresholds",
                "label": "Thresholds (Grafana steps JSON)",
                "type": "text",
                "default": ""
            },
            {
                "name": "valueMappings",
                "label": "Value mappings (Grafana mappings JSON)",
                "type": "text",
                "default": ""
            },
            {
                "name": "graphMode",
                "label": "Graph mode",
                "type": "select",
                "choices": [
                    {
                        "value": "area",
                        "label": "Area"
                    },
                    {
                        "value": "none",
                        "label": "None"
                    }
                ],
                "default": "area"
            },
            {
                "name": "colorMode",
                "label": "Colour mode",
                "type": "select",
                "choices": [
                    {
                        "value": "value",
                        "label": "Value"
                    },
                    {
                        "value": "background",
                        "label": "Background"
                    },
                    {
                        "value": "none",
                        "label": "None"
                    }
                ],
                "default": "value"
            }
        ],
        "colorPalette": null
    },
