{
    "name": "Heatmap",
    "description": "Draws a time by bucket grid for latency histograms, one cell per time and bucket coloured by value, with buckets in numeric order and +Inf last.",
    "version": "1.0.0",
    "publishedAt": "2026-11-08T00:00:00.000Z",
    "changelog": "Initial HouseRx release.",
    "tags": ["houserx", "distribution", "latency"],
    "icon": "chart-grid-dots",
    "vizSchema": {
        "fields": [
            {
                "name": "time",
                "label": "Time",
                "type": "dimension",
                "required": true,
                "description": "The time each row's histogram was sampled at (one column per distinct time)."
            },
            {
                "name": "bucket",
                "label": "Bucket",
                "type": "dimension",
                "required": true,
                "description": "The histogram bucket upper bound, such as a Prometheus le label (0.1, 0.5, 1, +Inf). Sorted numerically, +Inf last."
            },
            {
                "name": "value",
                "label": "Value",
                "type": "metric",
                "required": true,
                "description": "The count or rate in that bucket at that time; sets the cell colour. Repeated time and bucket pairs add up."
            }
        ],
        "configOptions": [
            {
                "name": "colorScale",
                "label": "Colour scale",
                "type": "gradient",
                "default": {
                    "colors": ["#FCE2C9", "#FF9830", "#C4162A"],
                    "min": "auto",
                    "max": "auto"
                }
            }
        ],
        "colorPalette": null
    },
