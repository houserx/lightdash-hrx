            { "name": "worker", "value": 67 },
            { "name": "scheduler", "value": 18 },
            { "name": "db", "value": 88 }
        ],
        "optionValues": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": "{\"mode\":\"absolute\",\"steps\":[{\"value\":null,\"color\":\"green\"},{\"value\":60,\"color\":\"orange\"},{\"value\":80,\"color\":\"red\"}]}"
        }
    }
