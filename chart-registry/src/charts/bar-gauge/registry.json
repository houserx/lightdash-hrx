{
    "name": "Bar gauge",
    "description": "Draws one bar per row, filled by its value between min and max (clamped at both ends), horizontal or vertical, each labelled with its name and its value formatted with a Grafana unit. Bars are coloured by Grafana thresholds, solid (basic) or as a gradient (gradient).",
    "version": "1.1.0",
    "publishedAt": "2026-11-08T00:00:00.000Z",
    "changelog": "Bars take their Grafana threshold colour (absolute or percentage steps against min..max): solid in basic mode, a gradient through the threshold colours in gradient mode.",
    "tags": ["houserx", "gauge", "bar-gauge"],
    "icon": "chart-bar",
    "vizSchema": {
        "fields": [
            {
                "name": "name",
                "label": "Name",
                "type": "dimension",
                "required": true,
                "description": "The label of each bar. One bar is drawn per row, in row order."
            },
            {
                "name": "value",
                "label": "Value",
                "type": "metric",
                "required": true,
                "description": "The number each bar is filled to between min and max. An empty cell draws an empty bar."
            }
        ],
        "configOptions": [
            {
                "name": "orientation",
                "label": "Orientation",
                "type": "select",
                "choices": [
                    {
                        "value": "horizontal",
                        "label": "Horizontal"
                    },
                    {
                        "value": "vertical",
                        "label": "Vertical"
                    }
                ],
                "default": "horizontal"
            },
            {
                "name": "displayMode",
                "label": "Display mode",
                "type": "select",
                "choices": [
                    {
                        "value": "gradient",
                        "label": "Gradient"
                    },
                    {
                        "value": "basic",
                        "label": "Basic"
                    }
                ],
                "default": "gradient"
            },
            {
                "name": "min",
                "label": "Min",
                "type": "number",
                "default": 0
            },
            {
                "name": "max",
                "label": "Max",
                "type": "number",
                "default": 100
            },
            {
                "name": "unit",
                "label": "Unit",
                "type": "text",
                "default": ""
            },
            {
                "name": "decimals",
                "label": "Decimals (-1 for auto)",
                "type": "number",
                "default": -1,
                "min": -1,
                "max": 20
            },
            {
                "name": "thresholds",
                "label": "Thresholds (Grafana steps JSON)",
                "type": "text",
                "default": ""
            }
        ],
        "colorPalette": null
    },
    "preview": {
        "rows": [
