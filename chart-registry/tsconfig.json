{
    "extends": "./../tsconfig.json",
    "compilerOptions": {
        "target": "ES2020",
        "module": "esnext",
        "lib": ["ESNext", "DOM"],
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
