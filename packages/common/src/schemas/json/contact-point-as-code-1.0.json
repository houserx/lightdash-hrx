{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.lightdash.com/lightdash/contact-point-as-code.json",
    "title": "Lightdash Contact Point as Code",
    "description": "One Contact Point (ENG-1799), stored as contact-points/<slug>.yml. Secrets are never inline: Slack webhook URLs, incident.io tokens and webhook authorization are { secretRef: <name> }.",
    "type": "object",
    "required": ["version", "type", "slug", "name", "integrations"],
    "additionalProperties": false,
    "properties": {
        "version": {
            "const": 1,
            "description": "Document format version"
        },
        "type": {
            "const": "contact_point"
        },
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable identifier; Notification Routes refer to Contact Points by slug"
        },
        "name": {
            "type": "string",
            "pattern": "\\S"
        },
        "integrations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/Integration"
            }
        }
    },
    "$defs": {
        "SecretRef": {
            "type": "object",
            "description": "Reference to a secret held by Lightdash; the value itself never appears in alerting code",
            "required": ["secretRef"],
            "additionalProperties": false,
            "properties": {
                "secretRef": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                }
            },
            "errorMessage": "must be a secret reference { secretRef: <name> }; secrets are never written inline"
        },
        "Template": {
            "type": "string",
            "description": "Message template (Go text/template subset, with the ported Grafana templates available)"
        },
        "Integration": {
            "type": "object",
            "required": ["type"],
            "properties": {
                "type": {
                    "enum": [
                        "slack_webhook",
                        "slack_app",
                        "incident_io",
                        "email",
                        "webhook"
                    ]
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": { "type": { "const": "slack_webhook" } }
                    },
                    "then": { "$ref": "#/$defs/SlackWebhookIntegration" }
                },
                {
                    "if": {
                        "properties": { "type": { "const": "slack_app" } }
                    },
                    "then": { "$ref": "#/$defs/SlackAppIntegration" }
                },
                {
                    "if": {
                        "properties": { "type": { "const": "incident_io" } }
                    },
                    "then": { "$ref": "#/$defs/IncidentIoIntegration" }
                },
                {
                    "if": {
                        "properties": { "type": { "const": "email" } }
                    },
                    "then": { "$ref": "#/$defs/EmailIntegration" }
                },
                {
                    "if": {
                        "properties": { "type": { "const": "webhook" } }
                    },
                    "then": { "$ref": "#/$defs/WebhookIntegration" }
                }
            ]
        },
        "SlackWebhookIntegration": {
            "description": "Slack incoming webhook; the webhook URL is a secret",
            "required": ["type", "url"],
            "additionalProperties": false,
            "properties": {
                "type": true,
                "url": { "$ref": "#/$defs/SecretRef" },
                "title": { "$ref": "#/$defs/Template" },
                "text": { "$ref": "#/$defs/Template" },
                "disableResolveMessage": { "type": "boolean" }
            }
        },
        "SlackAppIntegration": {
            "description": "Post through the organization's installed Lightdash Slack app",
            "required": ["type", "channel"],
            "additionalProperties": false,
            "properties": {
                "type": true,
                "channel": { "type": "string", "pattern": "\\S" },
                "title": { "$ref": "#/$defs/Template" },
                "text": { "$ref": "#/$defs/Template" },
                "disableResolveMessage": { "type": "boolean" }
            }
        },
        "IncidentIoIntegration": {
            "description": "incident.io alert source receiving Alertmanager webhook v4 payloads; the bearer token is a secret",
            "required": ["type", "url", "token"],
            "additionalProperties": false,
            "properties": {
                "type": true,
                "url": { "type": "string", "format": "uri" },
                "token": { "$ref": "#/$defs/SecretRef" },
                "disableResolveMessage": { "type": "boolean" }
            }
        },
        "EmailIntegration": {
            "description": "Email through Lightdash's email client",
            "required": ["type", "addresses"],
            "additionalProperties": false,
            "properties": {
                "type": true,
                "addresses": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "format": "email" }
                },
                "disableResolveMessage": { "type": "boolean" }
            }
        },
        "WebhookIntegration": {
            "description": "Generic webhook receiving Alertmanager webhook v4 payloads; the optional Authorization header value is a secret",
            "required": ["type", "url"],
            "additionalProperties": false,
            "properties": {
                "type": true,
                "url": { "type": "string", "format": "uri" },
                "authorization": { "$ref": "#/$defs/SecretRef" },
                "maxAlerts": { "type": "integer", "minimum": 0 },
                "disableResolveMessage": { "type": "boolean" }
            }
        }
    }
}
