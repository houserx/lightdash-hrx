          "expr": "topk(10,\n  sum by (http_route, http_request_method) (\n    increase(http_server_request_duration_seconds_sum{\n      k8s_namespace_name=~\"$namespace\",\n      service_name=~\"$service\",\n      http_route!=\"/metrics\",\n      http_route!=\"/healthcheck\",\n      http_route!=\"/\",\n      http_route!=\"/*\",\n    }[$__range])\n  )\n  /\n  clamp_min(\n    sum by (http_route, http_request_method) (\n      increase(http_server_request_duration_seconds_count{\n        k8s_namespace_name=~\"$namespace\",\n        service_name=~\"$service\",\n        http_route!=\"/metrics\",\n        http_route!=\"/healthcheck\",\n        http_route!=\"/\",\n        http_route!=\"/*\",\n      }[$__range])\n    ),\n    1  # Prevent division by zero\n  )\n)",
