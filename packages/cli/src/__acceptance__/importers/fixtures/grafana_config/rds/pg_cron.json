        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${instance}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \nCASE \n    WHEN jrd.status = 'succeeded' THEN '🟢'\n    WHEN jrd.status = 'failed' THEN '🔴'\n    ELSE '⁉️'\n    END AS status,\n    j.jobname,\n    jrd.return_message AS result,\n    j.command,\n    j.schedule,\n    j.database,\n    j.active\n    \nFROM \n    cron.job j\nINNER JOIN (\n    SELECT \n        jobid,\n        status,\n        return_message,\n        ROW_NUMBER() OVER (PARTITION BY jobid ORDER BY end_time DESC NULLS LAST) as rn\n    FROM \n        cron.job_run_details\n) jrd ON j.jobid = jrd.jobid AND jrd.rn = 1",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Jobs",
      "type": "table"
