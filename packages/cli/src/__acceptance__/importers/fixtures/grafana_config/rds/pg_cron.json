          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT \n    job.jobname as job_name,\n    start_time as time,\n    EXTRACT(EPOCH FROM (end_time - start_time)) * 1000 AS duration_ms\nFROM \n    cron.job_run_details\nINNER JOIN \n    cron.job ON job.jobid = job_run_details.jobid\nWHERE $__timeFilter(start_time) \nORDER BY 2",
