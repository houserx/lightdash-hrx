{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023"],
        "types": ["node"],
        "strict": true,
        "noImplicitAny": true,
        "useUnknownInCatchVariables": true,
        "declaration": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src",
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "node_modules", "tests", "src/**/*.test.ts"]
}
