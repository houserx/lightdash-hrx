{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["es2022", "dom"],
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["**/*.ts", "**/*.mts", "**/*.cts"],
    "exclude": ["node_modules", ".state", "out", "test-results", "playwright-report"]
}
