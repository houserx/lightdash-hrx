{
  "__inputs": [
    {
      "name": "DS_DEMO_PROMETHEUS",
      "label": "Demo Prometheus",
      "description": "Synthetic ENG-1799 demo fixture: the fake Prometheus of demo/eng-1799/stack/prometheus.ts",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Synthetic Grafana dashboard for the ENG-1799 demo. Fill queue health from hrx_fill_queue_backlog. Converted by hand to demo/eng-1799/content/dashboards/pharmacy-ops-overview.yml.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_DEMO_PROMETHEUS}" },
      "description": "The latest hrx_fill_queue_backlog{queue=\"fill\"} sample. Red at 100 and above, the alert threshold.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "displayName": "Messages waiting in the fill queue",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_DEMO_PROMETHEUS}" },
          "expr": "hrx_fill_queue_backlog{queue=\"fill\"}",
          "refId": "A"
        }
      ],
      "title": "Current fill queue backlog",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_DEMO_PROMETHEUS}" },
      "description": "hrx_fill_queue_backlog{queue=\"fill\"}. The alert \"Fill queue backlog high\" fires at 100, drawn as a dashed threshold line.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "max": 200,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#73BF69", "value": null },
              { "color": "#F2495C", "value": 100 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_DEMO_PROMETHEUS}" },
          "expr": "hrx_fill_queue_backlog{queue=\"fill\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Fill queue backlog",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_DEMO_PROMETHEUS}" },
      "description": "The highest hrx_fill_queue_backlog per queue in the time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 200,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["max"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_DEMO_PROMETHEUS}" },
          "expr": "hrx_fill_queue_backlog",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Peak backlog by queue",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_DEMO_PROMETHEUS}" },
      "description": "Each queue's peak hrx_fill_queue_backlog, with a Status column from value mappings.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  { "options": { "from": null, "result": { "color": "green", "index": 0, "text": "OK" }, "to": 59.999 }, "type": "range" },
                  { "options": { "from": 60, "result": { "color": "orange", "index": 1, "text": "Elevated" }, "to": 99.999 }, "type": "range" },
                  { "options": { "from": 100, "result": { "color": "red", "index": 2, "text": "Backlogged" }, "to": null }, "type": "range" }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "cellHeight": "sm", "showHeader": true, "sortBy": [{ "desc": false, "displayName": "Queue" }] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_DEMO_PROMETHEUS}" },
          "expr": "max by (queue) (max_over_time(hrx_fill_queue_backlog[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Queue status",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "queue": 0, "Value": 1 },
            "renameByName": { "queue": "Queue", "Value": "Peak backlog" }
          }
        },
        {
          "id": "calculateField",
          "options": { "alias": "Status", "mode": "reduceRow", "reduce": { "include": ["Peak backlog"], "reducer": "max" } }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["eng-1799-demo", "synthetic"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Pharmacy Ops overview",
  "uid": "eng1799-demo-pharmacy-ops",
  "version": 1,
  "weekStart": ""
}
